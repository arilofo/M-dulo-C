Codigo en plantUML:
Código:
@startuml
left to right direction

skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 70
skinparam shadowing false

' Configuración de colores personalizada
skinparam usecase {
    BackgroundColor #14532d
    BorderColor white
    FontColor white
}

skinparam actor {
    BorderColor black
    FontColor black
}

skinparam rectangle {
    BorderColor black
    FontColor black
}

' ======================
' ACTORES PRIMARIOS - IZQUIERDA
' ======================
actor "Jefe de Compras\n(primario)" as JC
actor "Tesorero\n(primario)" as TE
actor "Administrador del sistema\n(primario)" as ADM

JC -[hidden]down- TE
TE -[hidden]down- ADM

' ======================
' SISTEMA
' ======================
rectangle "Sistema SIGE — Módulo C: Cuentas por Pagar" as SIGE {

  package "Casos de uso principales" {
    usecase "CU-01\nGestionar proveedores" as UC1
    usecase "CU-02\nCrear orden de compra" as UC2
    usecase "CU-03\nRegistrar recepción\nde mercadería" as UC3
    usecase "CU-05\nIngresar factura\nde proveedor" as UC4
    usecase "CU-07\nRegistrar pago\na proveedor" as UC5
    usecase "CU-09\nGenerar estado\nde cuenta" as UC6
    usecase "CU-11\nConsultar órdenes\npendientes" as UC7
    usecase "CU-12\nGenerar reporte\nde obligaciones" as UC8
  }

  package "Casos de uso de integración / automáticos" {
    usecase "CU-13\nConsultar catálogo\nde productos (Mód. B)" as UCI1 #4338ca
    usecase "CU-04\nActualizar inventario\n(Mód. B)" as UCI2 #4338ca
    usecase "CU-06\nGenerar cuenta\npor pagar" as UCI3 #4338ca
    usecase "CU-08\nActualizar saldo\npendiente" as UCI4 #4338ca
    usecase "CU-14\nExponer precio\nde costo (Mód. A)" as UCI5 #4338ca
    usecase "CU-15\nConsultar tarifa IVA\ny retenciones (Mód. D)" as UCI6 #4338ca
    usecase "CU-16\nEnviar datos factura\na Módulo D" as UCI7 #4338ca
  }

  package "Casos de uso condicionales / excepcionales" {
    usecase "CU-10\nAlertar pagos\npor vencer" as UCE1 #92400e
    usecase "CU-17\nAutorizar factura\nexcepcional sin OC" as UCE2 #92400e
  }

  ' Orden interno sugerido
  UC1 -[hidden]down- UC2
  UC2 -[hidden]down- UC3
  UC3 -[hidden]down- UC4
  UC4 -[hidden]down- UC5
  UC5 -[hidden]down- UC6
  UC6 -[hidden]down- UC7
  UC7 -[hidden]down- UC8

  UCI1 -[hidden]down- UCI2
  UCI2 -[hidden]down- UCI3
  UCI3 -[hidden]down- UCI4
  UCI4 -[hidden]down- UCI5
  UCI5 -[hidden]down- UCI6
  UCI6 -[hidden]down- UCI7

  UCE1 -[hidden]down- UCE2
}

' ======================
' ACTORES SECUNDARIOS - DERECHA
' ======================
actor "Módulo B\nInventarios\n(secundario)" as MB <<system>>
actor "Módulo A\nFacturación\n(secundario)" as MA <<system>>
actor "Módulo D\nImpuestos\n(secundario)" as MD <<system>>

MB -[hidden]down- MA
MA -[hidden]down- MD

' Fuerza la ubicación general:
' actores primarios izquierda -> sistema -> módulos externos derecha
ADM -[hidden]right- SIGE
SIGE -[hidden]right- MB

' ======================
' RELACIONES ACTORES -> CASOS DE USO
' ======================

' Jefe de Compras — ciclo operativo
JC -- UC1
JC -- UC2
JC -- UC3
JC -- UC4
JC -- UC7

' Tesorero — ciclo financiero
TE -- UC5
TE -- UC6
TE -- UC8

' Administrador del sistema — acceso transversal y autorización excepcional
ADM -- UC1
ADM -- UC2
ADM -- UC3
ADM -- UC4
ADM -- UC5
ADM -- UC6
ADM -- UC7
ADM -- UC8
ADM -- UCE2

' Módulo B — genera solicitudes de compra por stock mínimo
MB -- UC2

' Módulo B — recibe la notificación de actualización de inventario
MB -- UCI2

' Módulo A — consulta el precio de costo expuesto por el Módulo C
MA -- UCI5

' Módulo D — provee tarifas/retenciones y recibe datos de facturas
MD -- UCI6
MD -- UCI7

' ======================
' RELACIONES DE INCLUSIÓN (<<include>>)
' ======================

UC2 ..> UCI1 : <<include>>
UC3 ..> UCI2 : <<include>>
UC4 ..> UCI3 : <<include>>
UC4 ..> UCI6 : <<include>>
UC4 ..> UCI7 : <<include>>
UC5 ..> UCI4 : <<include>>

' ======================
' RELACIONES DE EXTENSIÓN (<<extend>>)
' ======================

UCE1 ..> UC6 : <<extend>>
UCE2 ..> UC4 : <<extend>>
@enduml
